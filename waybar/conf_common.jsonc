// Full panel layout. Shared module options are in modules.jsonc.
{
    "name": "main",
    "layer": "top",
    "position": "top",
    "fixed-center": false,
    "spacing": 2,
    "modules-left": ["custom/logo", "hyprland/workspaces"],
    "modules-center": [
        "disk",
        "memory",
        "cpu",
        "temperature",
        "custom/nextcloud_sync",
        "custom/site_check",
        "custom/vpn_check",
        "custom/ext_ip_check",
        "network"
    ],
    "modules-right": [
        "custom/tablet_battery",
        "custom/dualsense_battery",
        "pulseaudio",
        "bluetooth",
        "backlight",
        "battery",
        "hyprland/language",
        "clock",
        "tray"
    ],
    "include": "$HOME/.config/waybar/modules.jsonc"
}
