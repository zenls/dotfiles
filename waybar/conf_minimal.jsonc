// Secondary panel: workspaces, OpenCode status, and the shared clock/calendar.
{
    "name": "second",
    "modules-left": ["hyprland/workspaces"],
    "modules-center": [],
    "modules-right": ["custom/opencode", "clock"],
    "include": "$HOME/.config/waybar/conf_common.jsonc",
    "clock": {
        "format": " {:%H:%M:%S %d.%m.%Y}"
    }
}
