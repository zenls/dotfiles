// Shared module options. Layouts decide which modules are instantiated.
{
    // Navigation
    "custom/logo": {
        "format": "󰣇",
        "tooltip": false,
        "menu": "on-click",
        "menu-file": "$HOME/.config/waybar/power_menu.xml",
        "menu-actions": {
            "shutdown": "systemctl poweroff",
            "reboot": "systemctl reboot"
        }
    },
    "hyprland/workspaces": {
        "active-only": false,
        "tooltip": false,
        "enable-bar-scroll": true,
        "sort-by": "id",
        "format": "{name}"
    },

    // System
    "cpu": {
        "interval": 1,
        "format": " {usage}%"
    },
    "memory": {
        "interval": 5,
        "format": " {used:0.1f}G/{percentage}%"
    },
    "disk": {
        "interval": 30,
        "format": "󰋊 {specific_used:0.0f}G/{specific_total:0.0f}G",
        "unit": "GiB"
    },
    "temperature": {
        "interval": 5,
        "hwmon-path-abs": "/sys/devices/platform/coretemp.0/hwmon",
        "input-filename": "temp1_input",
        "critical-threshold": 80,
        "format": "{icon} {temperatureC}°C",
        "format-icons": ["", "", ""]
    },

    // Connectivity and audio
    "network": {
        "interval": 1,
        "align": 0,
        "min-length": 42,
        "max-length": 42,
        "format-wifi": "󰖩 {ipaddr}  {bandwidthUpBits}  {bandwidthDownBits}",
        "format-ethernet": "󰈀  {bandwidthUpBits}  {bandwidthDownBits}",
        "format-linked": "󰈀 {ifname} (No IP)",
        "format-disconnected": "⚠ Disconnected ⚠",
        "tooltip-format": "{ifname} -> {ipaddr}:{gwaddr}:{netmask}",
        "tooltip-format-wifi": "{ifname} -> {essid} ({frequency}GHz):{signaldBm}dBm{signalStrength}% \n{ipaddr}:{gwaddr}:{netmask}"
    },
    "pulseaudio": {
        "format": "{format_source} | {icon} {volume}%",
        "format-muted": "{format_source} ",
        "format-source": "󰍬 {volume}%",
        "format-source-muted": "󰍭",
        "format-icons": {
            "headphone": "󰋋",
            "hands-free": "",
            "headset": "",
            "phone": "",
            "portable": "",
            "car": "",
            "speaker": "󰓃",
            "hdmi": "󰡁",
            "hifi": "󰤽",
            "default": [""]
        },
        "on-scroll-up": "pactl set-source-volume @DEFAULT_SOURCE@ +1%",
        "on-scroll-down": "pactl set-source-volume @DEFAULT_SOURCE@ -1%",
        "tooltip-format": "{icon} {desc} {volume}%, {format_source}"
    },
    "bluetooth": {
        "format": "󰂯 {status}",
        "format-disabled": "󰂲",
        "format-connected": "󰂯 {num_connections}",
        "tooltip-format": "{controller_alias}\t{controller_address}\n{num_connections} dev",
        "tooltip-format-connected": "{controller_alias}\t{controller_address}\n{num_connections} connected\n{device_enumerate}",
        "tooltip-format-enumerate-connected": "{device_alias}\t{device_address}",
        "tooltip-format-enumerate-connected-battery": "{device_alias}\t{device_address}\t{device_battery_percentage}%"
    },

    // Drawing tablet: hidden when no connected Wacom battery is available.
    "custom/tablet_battery": {
        "exec": "$HOME/.config/dotfiles/scripts/hid_battery.sh 'wacom_battery_*'",
        "interval": 5,
        "return-type": "json",
        "format": "<span size='120%'>󱦹</span> {text}",
        "hide-empty-text": true,
        "tooltip": true
    },

    // PlayStation controller: name and battery details come from the HID driver.
    "custom/dualsense_battery": {
        "exec": "$HOME/.config/dotfiles/scripts/hid_battery.sh 'ps-controller-battery-*'",
        "interval": 5,
        "return-type": "json",
        "format": "<span size='120%'>󰊴</span> {text}",
        "hide-empty-text": true,
        "tooltip": true
    },

    // Laptop status
    "backlight": {
        "format": "{icon}  {percent}%",
        "format-icons": ["󱩎", "󱩑", "󱩔", "󰛨"]
    },
    "battery": {
        "states": {
            "warning": 20,
            "critical": 10
        },
        "format": "{icon} {capacity}%",
        "format-full": "{icon} {capacity}%",
        "format-charging": "󰂄 {capacity}%",
        "format-plugged": " {capacity}%",
        "format-icons": ["󰂎", "󱊡", "󱊢", "󱊣"]
    },

    // Session
    "hyprland/language": {
        "format": "{}",
        "format-en": "EN",
        "format-ru": "RU",
        "format-de": "DE"
    },
    "clock": {
        "interval": 1,
        "format": " {:%H:%M:%S}",
        "tooltip-format": "<tt><small><span size='12pt'>{calendar}</span></small></tt>",
        "actions": {
            "on-scroll-up": "shift_up",
            "on-scroll-down": "shift_down",
            "on-click-right": "mode"
        },
        "calendar": {
            "mode": "month",
            "mode-mon-col": 3,
            "weeks-pos": "left",
            "on-scroll": 1,
            "format": {
                "months": "<span color='#ffead3'><b>{}</b></span>",
                "days": "<span color='#ecc6d9'><b>{}</b></span>",
                "weeks": "<span color='#99ffdd'><b>W{}</b></span>",
                "weekdays": "<span color='#ffcc66'><b>{}</b></span>",
                "today": "<span color='#ff6699'><b><u>{}</u></b></span>"
            }
        }
    },
    "tray": {
        "icon-size": 15,
        "spacing": 5
    },

    // Custom status commands
    "custom/nextcloud_sync": {
        "interval": 3,
        "exec": "$HOME/.config/dotfiles/scripts/nextcloud_sync.sh",
        "on-click": "$HOME/.config/dotfiles/scripts/nextcloud_sync.sh -f",
        "format": "{} ",
        "tooltip-format": "Nextcloud sync, last status: {}."
    },
    "custom/site_check": {
        "interval": 600,
        "exec": "$HOME/.config/dotfiles/scripts/site_check.sh",
        "on-click": "$HOME/.config/dotfiles/scripts/site_check.sh",
        "return-type": "json",
        "format": "{} "
    },
    "custom/vpn_check": {
        "interval": 3,
        "exec": "$HOME/.config/dotfiles/scripts/network_state.sh --vpn",
        "return-type": "json",
        "format": "{} "
    },
    "custom/ext_ip_check": {
        "interval": 300,
        "exec": "$HOME/.config/dotfiles/scripts/ip_check_adv.sh",
        "on-click": "$HOME/.config/dotfiles/scripts/ip_check_adv.sh --refresh",
        "exec-on-event": false,
        "signal": 8,
        "return-type": "json",
        "format": "{}"
    }
}
